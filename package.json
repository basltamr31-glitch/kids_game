{
  "name": "little-alpine-days",
  "version": "0.1.0",
  "private": true,
  "description": "Little Alpine Days - a cozy offline 3D childhood game set on an Alpine family farm.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleRelease",
    "android:aab": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "ios:add": "cap add ios",
    "icons": "node tools/generate-icons.mjs",
    "store:screenshots": "node tools/capture-store-screenshots.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/screen-orientation": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
