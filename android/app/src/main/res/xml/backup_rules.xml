<?xml version="1.0" encoding="utf-8"?>
<!--
  Android auto-backup. The save and settings live in Capacitor Preferences,
  which is a SharedPreferences file, so backing that up means a child keeps
  their farm when they move to a new device. Nothing else is worth backing up:
  the web assets are reinstalled and there is no cache to preserve.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
